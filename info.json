    {
      "name": "dprint-plugin-exec",
      "displayName": "dprint-plugin-exec",
      "repoUrl": "https://github.com/dprint/dprint-plugin-exec",
      "description": "Formats code using formatting CLIs installed on the host machine (rustfmt, clang-format, shfmt, etc.).",
      "website": "https://dprint.dev/plugins/exec/",
      "npm": {
        "name": "@dprint/exec"
      },
      "selected": false,
      "configKey": "exec",
      "keywords": [
        "rust",
        "rustfmt",
        "c",
        "c++",
        "cpp",
        "clang",
        "clang-format",
        "shell",
        "bash",
        "shfmt",
        "zig",
        "cli"
      ],
      "fileExtensions": [],
      "configExcludes": [],
      "defaultConfig": {
        "cwd": "${configDir}"
      },
      "configItems": [
        {
          "match": {
            "fileExtensions": [
              "rs"
            ]
          },
          "config": {
            "commands": [
              {
                "command": "rustfmt",
                "exts": [
                  "rs"
                ]
              }
            ]
          }
        },
        {
          "match": {
            "fileExtensions": [
              "c",
              "cc",
              "cpp",
              "cxx",
              "h",
              "hpp",
              "hxx",
              "m",
              "mm"
            ]
          },
          "config": {
            "commands": [
              {
                "command": "clang-format",
                "exts": [
                  "c",
                  "cc",
                  "cpp",
                  "cxx",
                  "h",
                  "hpp",
                  "hxx",
                  "m",
                  "mm"
                ]
              }
            ]
          }
        },
        {
          "match": {
            "fileExtensions": [
              "sh",
              "bash"
            ]
          },
          "config": {
            "commands": [
              {
                "command": "shfmt",
                "exts": [
                  "sh",
                  "bash"
                ]
              }
            ]
          }
        },
        {
          "match": {
            "fileExtensions": [
              "zig"
            ]
          },
          "config": {
            "commands": [
              {
                "command": "zig fmt --stdin",
                "exts": [
                  "zig"
                ]
              }
            ]
          }
        }
      ]
    },
